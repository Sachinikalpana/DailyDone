<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dev Info Background Image Layer -->
    <ImageView
        android:id="@+id/devInfoBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/dev_info_bg"
        android:scaleType="centerCrop"
        android:alpha="0.85"
        android:contentDescription="@null"
        tools:ignore="ContentDescription" />

    <!-- Main Foreground Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/devProfileImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="48dp"
            android:src="@drawable/dev_img"
            android:contentDescription="Developer profile picture" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Dev Info"
            android:textSize="32sp"
            android:fontFamily="@font/roboto_bold"
            android:textStyle="bold"
            android:textColor="@color/primary_brand_blue"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/infoBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/user_block_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A.M.A.S.S. Kalpana"
                android:fontFamily="@font/roboto_bold"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_gravity="center_horizontal"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="2023t01869"
                android:fontFamily="@font/roboto_bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_gravity="center_horizontal"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="I am a University of Colombo Faculty of Technology student interested in UI/UX and Development to find solutions to real life problems."
                android:textColor="#000000"
                android:fontFamily="@font/roboto_regular"
                android:textSize="14sp"
                android:gravity="center"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="v1.0.0"
                android:textColor="#000000"
                android:fontFamily="@font/roboto_bold"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDevBack"
            android:layout_width="312dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary_brand_blue"
            android:text="Back"
            android:fontFamily="@font/roboto_bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</FrameLayout>