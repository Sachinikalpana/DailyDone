<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

  <ImageView
      android:id="@+id/signup_logo"
      android:layout_width="90dp"
      android:layout_height="90dp"
      android:layout_marginTop="40dp"
      android:src="@drawable/login_img"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <TextView
      android:id="@+id/signup_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="155dp"
      android:layout_marginTop="24dp"
      android:layout_marginEnd="155dp"
      android:fontFamily="@font/roboto_bold"
      android:text="@string/create_account_title"
      android:textColor="#002368"
      android:textSize="32sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/signup_logo" />

  <EditText
      android:id="@+id/reg_username"
      android:layout_width="364dp"
      android:layout_height="56dp"
      android:layout_marginStart="24dp"
      android:layout_marginTop="24dp"
      android:layout_marginEnd="24dp"
      android:background="@drawable/edittext_rounded_corners"
      android:fontFamily="@font/roboto_regular"
      android:hint="Username"
      android:paddingStart="15dp"
      android:textColor="#000000"
      android:textColorHint="#FFFFFF"
      android:textSize="16sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/signup_title" />

  <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/layout_password"
      android:layout_width="364dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      app:hintEnabled="false"
      app:passwordToggleEnabled="true"
      app:passwordToggleTint="@color/white"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/reg_username">

    <EditText
        android:id="@+id/reg_password"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/edittext_rounded_corners"
        android:fontFamily="@font/roboto_regular"
        android:hint="@string/password_hint"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:textColor="#000000"
        android:textColorHint="#FFFFFF" />
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/layout_confirm_password"
      android:layout_width="364dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      app:hintEnabled="false"
      app:passwordToggleEnabled="true"
      app:passwordToggleTint="@color/white"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/layout_password">

    <EditText
        android:id="@+id/reg_confirm_password"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/edittext_rounded_corners"
        android:fontFamily="@font/roboto_regular"
        android:hint="@string/confirm_password_hint"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:textColor="#000000"
        android:textColorHint="#FFFFFF" />
  </com.google.android.material.textfield.TextInputLayout>

  <EditText
      android:id="@+id/reg_email"
      android:layout_width="364dp"
      android:layout_height="56dp"
      android:layout_marginTop="16dp"
      android:background="@drawable/edittext_rounded_corners"
      android:fontFamily="@font/roboto_regular"
      android:hint="@string/email_label"
      android:inputType="textEmailAddress"
      android:paddingStart="16dp"
      android:textColor="#000000"

      android:textColorHint="#FFFFFF"
      android:textSize="16sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/layout_confirm_password" />

  <Button
      android:id="@+id/button_signup_submit"
      android:layout_width="364dp"
      android:layout_height="48dp"
      android:layout_marginTop="24dp"
      android:backgroundTint="#1A237E"
      android:fontFamily="@font/roboto_bold"
      android:text="@string/btn_signup"
      android:textColor="#FFFFFF"

      app:cornerRadius="24dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/reg_email" />

</androidx.constraintlayout.widget.ConstraintLayout>