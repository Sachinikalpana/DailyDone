<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <!-- Background Image Layer -->
  <ImageView
      android:id="@+id/signUpBgImage"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:src="@drawable/signup_bg"
      android:scaleType="centerCrop"
      android:alpha="0.6"
      android:contentDescription="@null"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <ImageView
      android:id="@+id/signup_logo"
      android:layout_width="90dp"
      android:layout_height="90dp"
      android:layout_marginTop="40dp"
      android:src="@drawable/login_img"
      android:contentDescription="@null"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <TextView
      android:id="@+id/signup_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:fontFamily="@font/roboto_bold"
      android:text="@string/create_account_title"
      android:textColor="@color/primary_brand_blue"
      android:textSize="32sp"
      android:textStyle="bold"
      tools:ignore="HardcodedText"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/signup_logo" />

  <EditText
      android:id="@+id/reg_username"
      android:layout_width="364dp"
      android:layout_height="56dp"
      android:layout_marginStart="24dp"
      android:layout_marginTop="24dp"
      android:layout_marginEnd="24dp"
      android:background="@drawable/edittext_rounded_corners"
      android:fontFamily="@font/roboto_regular"
      android:hint="Username"
      android:paddingStart="16dp"
      android:textColor="#FFFFFF"
      android:textColorHint="#FFFFFF"
      android:textSize="16sp"
      tools:ignore="HardcodedText"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/signup_title" />

  <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/layout_password"
      android:layout_width="364dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      app:hintEnabled="false"
      app:passwordToggleEnabled="true"
      app:passwordToggleTint="@color/primary_brand_blue"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/reg_username">

    <EditText
        android:id="@+id/reg_password"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/edittext_rounded_corners"
        android:fontFamily="@font/roboto_regular"
        android:hint="@string/password_hint"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#FFFFFF" />
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/layout_confirm_password"
      android:layout_width="364dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      app:hintEnabled="false"
      app:passwordToggleEnabled="true"
      app:passwordToggleTint="@color/primary_brand_blue"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/layout_password">

    <EditText
        android:id="@+id/reg_confirm_password"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/edittext_rounded_corners"
        android:fontFamily="@font/roboto_regular"
        android:hint="@string/confirm_password_hint"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#FFFFFF" />
  </com.google.android.material.textfield.TextInputLayout>

  <EditText
      android:id="@+id/reg_email"
      android:layout_width="364dp"
      android:layout_height="56dp"
      android:layout_marginTop="16dp"
      android:background="@drawable/edittext_rounded_corners"
      android:fontFamily="@font/roboto_regular"
      android:hint="@string/email_label"
      android:inputType="textEmailAddress"
      android:paddingStart="16dp"
      android:textColor="#FFFFFF"
      android:textColorHint="#FFFFFF"
      android:textSize="16sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/layout_confirm_password" />

  <Button
      android:id="@+id/button_signup_submit"
      android:layout_width="364dp"
      android:layout_height="48dp"
      android:layout_marginTop="24dp"
      android:backgroundTint="@color/primary_brand_blue"
      android:fontFamily="@font/roboto_bold"
      android:text="@string/btn_signup"
      android:textColor="#FFFFFF"
      app:cornerRadius="24dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/reg_email" />

</androidx.constraintlayout.widget.ConstraintLayout>